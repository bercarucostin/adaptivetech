        "jsCode": "let raw=$json.text??$json.output??$json.response??\"\";\nif(typeof raw!==\"string\")raw=JSON.stringify(raw);\nraw=raw.trim().replace(/^```json\\s*/i,\"\").replace(/^```\\s*/i,\"\").replace(/\\s*```$/,\"\");\n\nlet plan={datasets:[],limit:1000};\ntry{plan=JSON.parse(raw);}catch{}\n\nconst bootstrap=$('Supabase - AI Bootstrap').first().json;\nconst allowed=new Set((bootstrap.catalog||[]).map(x=>String(x.dataset)));\nlet datasets=Array.isArray(plan.datasets)?plan.datasets.map(String).filter(x=>allowed.has(x)):[];\ndatasets=[...new Set(datasets)].slice(0,bootstrap.role===\"technician\"?3:20);\n\nlet limit=Number(plan.limit||1000);\nif(!Number.isFinite(limit))limit=1000;\nlimit=Math.max(1,Math.min(5000,Math.round(limit)));\n\nreturn [{json:{\n  datasets,\n  limit,\n  role:String(bootstrap.role||\"\"),\n  session_id:$('AI - Unified').first().json.session_id\n}}];"
