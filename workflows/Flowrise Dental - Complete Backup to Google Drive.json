    {
      "parameters": {
        "jsCode": "const complete = /^flowrise-supabase-\\d{8}T\\d{6}Z$/;\nconst incomplete = /^flowrise-supabase-incomplete-\\d{8}T\\d{6}Z$/;\nconst now = Date.now();\nconst staleBefore = now - 6 * 60 * 60 * 1000;\nconst folders = $input.all().map(item => item.json).filter(folder => folder.id && !folder.trashed);\nconst completed = folders.filter(folder => complete.test(folder.name || '')).sort((a, b) => String(b.createdTime || '').localeCompare(String(a.createdTime || '')) || String(b.id).localeCompare(String(a.id)));\nconst staleIncomplete = folders.filter(folder => {\n  if (!incomplete.test(folder.name || '')) return false;\n  const created = Date.parse(folder.createdTime || '');\n  return Number.isFinite(created) && created < staleBefore;\n});\nconst expired = [...completed.slice(1), ...staleIncomplete];\nreturn expired.length ? expired.map(folder => ({ json: { delete: true, id: folder.id, name: folder.name } })) : [{ json: { delete: false } }];"
      },
