      "parameters": {
        "jsCode": "const now = new Date();\nconst stamp = now.toISOString().replace(/[-:]/g, '').replace(/\\.\\d{3}Z$/, 'Z');\nreturn [{ json: {\n  started_at: now.toISOString(),\n  supabase_url: 'https://qlynvfltjgjgeipndior.supabase.co',\n  incomplete_folder_name: `flowrise-supabase-incomplete-${stamp}`,\n  complete_folder_name: `flowrise-supabase-${stamp}`,\n  max_estimated_bytes: 4 * 1024 * 1024 * 1024,\n} }];"
      },
