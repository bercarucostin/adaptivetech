        9776,
        1104
      ],
      "notesInFlow": true,
      "notes": "Înlocuiește REPLACE_PROJECT_REF o singură dată, după import, cu URL-ul proiectului Supabase."
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH public_size AS (\n  SELECT COALESCE(SUM(pg_total_relation_size(format('%I.%I', table_schema, table_name)::regclass)), 0)::bigint AS bytes\n  FROM information_schema.tables\n  WHERE table_schema = 'public' AND table_type = 'BASE TABLE'\n), storage_size AS (\n  SELECT COALESCE(SUM(CASE WHEN COALESCE(metadata->>'size', '') ~ '^[0-9]+$' THEN (metadata->>'size')::bigint ELSE 0 END), 0)::bigint AS bytes\n  FROM storage.objects\n)\nSELECT public_size.bytes AS public_relation_bytes,\n       storage_size.bytes AS storage_bytes,\n       (storage_size.bytes + GREATEST(public_size.bytes * 2, 134217728))::bigint AS estimated_backup_bytes\nFROM public_size CROSS JOIN storage_size;",
        "options": {}
      },
      "id": "7e9332a0-40b2-4423-b1f1-21d5f12f7a30",
      "name": "Estimate backup size",
