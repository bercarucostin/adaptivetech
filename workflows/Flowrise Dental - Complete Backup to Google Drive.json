    {
      "parameters": {
        "jsCode": "const quoteIdentifier = value => `\"${String(value).replace(/\"/g, '\"\"')}\"`;\nreturn $input.all().map(item => {\n  const schema = String(item.json.table_schema || '');\n  const table = String(item.json.table_name || '');\n  if (!schema || !table) throw new Error('Invalid table metadata');\n  const safeFile = `${schema}-${table}`.replace(/[^A-Za-z0-9._-]/g, '_');\n  const prefix = `table-${safeFile}-part-`;\n  return { json: {\n    table_schema: schema,\n    table_name: table,\n    filename_prefix: prefix,\n    query: `WITH numbered AS (SELECT row_number() OVER () AS rn, to_jsonb(src) AS row_data FROM ${quoteIdentifier(schema)}.${quoteIdentifier(table)} AS src), pages AS (SELECT ((rn - 1) / 1000)::bigint AS page_index, jsonb_agg(row_data ORDER BY rn) AS rows FROM numbered GROUP BY ((rn - 1) / 1000)::bigint) SELECT $1::text || lpad((page_index + 1)::text, 6, '0') || '.json' AS filename, jsonb_build_object('schema', $2::text, 'table', $3::text, 'page', page_index + 1, 'row_count', jsonb_array_length(rows), 'rows', rows)::text AS backup_json FROM pages UNION ALL SELECT $1::text || '000001.json', jsonb_build_object('schema', $2::text, 'table', $3::text, 'page', 1, 'row_count', 0, 'rows', '[]'::jsonb)::text WHERE NOT EXISTS (SELECT 1 FROM pages) ORDER BY filename`,\n  } };\n});"
      },
