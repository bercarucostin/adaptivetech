      "parameters": {
        "operation": "executeQuery",
        "query": "WITH numbered_objects AS (\n  SELECT row_number() OVER (ORDER BY bucket_id, name) AS backup_index,\n         bucket_id, name, owner_id, created_at, updated_at, last_accessed_at, metadata\n  FROM storage.objects\n  WHERE name IS NOT NULL\n)\nSELECT 'storage-manifest.json'::text AS filename,\n       jsonb_build_object(\n         'exported_at', now(),\n         'buckets', COALESCE((SELECT jsonb_agg(to_jsonb(b) ORDER BY b.id) FROM storage.buckets b), '[]'::jsonb),\n         'objects', COALESCE((SELECT jsonb_agg(to_jsonb(o) || jsonb_build_object('backup_file', 'storage-' || lpad(o.backup_index::text, 8, '0') || '.bin') ORDER BY o.backup_index) FROM numbered_objects o), '[]'::jsonb)\n       )::text AS backup_json;",
