    {
      "parameters": {
        "jsCode": "const estimate = Number($json.estimated_backup_bytes);\nconst limit = Number($('Prepare run').first().json.max_estimated_bytes);\nif (!Number.isSafeInteger(estimate) || estimate < 0) throw new Error('Supabase backup size estimate is invalid');\nif (estimate > limit) throw new Error('Estimated backup exceeds 4 GiB; two safe copies would exceed the reserved 8 GiB');\nreturn [{ json: { ...$('Prepare run').first().json, ...$json } }];"
      },
