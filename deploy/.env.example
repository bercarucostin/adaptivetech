# Copy to deploy/.env and fill in. deploy/.env is gitignored and must stay
# that way -- it holds the key that decrypts every credential n8n stores.

# ── Hostnames ────────────────────────────────────────────────────────────
# The bare domain. Caddy derives www.<this> and app.<this> from it.
SITE_DOMAIN=flowrisedental.ro

# The n8n editor's own hostname.
N8N_HOST=n8n.flowrisedental.ro

# "all" in production. Set to "noindex, nofollow" on any staging hostname:
# it serves the same unfinished site, and subdomains are discoverable through
# certificate transparency logs even when nothing links to them.
ROBOTS_TAG=all

# ── Secrets ──────────────────────────────────────────────────────────────
# Decrypts n8n's stored credentials. LOSING THIS LOSES THEM ALL -- there is
# no recovery, and n8n will refuse to start against an existing database with
# a different key. Back it up somewhere other than this box.
#   openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# Postgres holds n8n's own state: workflows, executions, credentials.
# The application's data is in Supabase, not here.
#   openssl rand -hex 24
POSTGRES_PASSWORD=
