# ---------------------------------------------------------------------------
# This deployment runs through Coolify, so DO NOT create a .env from this file
# on the server. Set each variable below in Coolify's Environment Variables for
# the resource; Coolify supplies them to compose at deploy time, and the values
# never touch the repository or the disk in plaintext.
#
# This file stays as the canonical list of WHAT must be set, and as the fallback
# for a plain `docker compose up` deployment without Coolify.
#
# Generate the four secrets locally, paste them into Coolify:
#     openssl rand -base64 48 | tr -d '\n'
#
# BACK UP N8N_ENCRYPTION_KEY SOMEWHERE OUTSIDE COOLIFY -- a password manager.
# It encrypts every credential n8n stores. Lose it or overwrite it and every
# stored API key and connection string is unrecoverable; you re-enter them all
# by hand. The other three can be regenerated with only a session reset.
# ---------------------------------------------------------------------------

DEMO_DOMAIN=adaptivetech.ro
N8N_HOST=n8n.adaptivetech.ro

# Admin IPs for the editor's allowlist. Best-effort behind three proxies --
# see the Caddyfile. The basic auth below is the factor that actually holds.
ADMIN_IPS=203.0.113.4

# Basic auth in front of the n8n editor, second factor behind ADMIN_IPS.
# Generate with: caddy hash-password
N8N_ADMIN_USER=admin
N8N_ADMIN_PASSWORD_HASH=

# openssl rand -base64 48
N8N_ENCRYPTION_KEY=
DEMO_SESSION_SECRET=
DEMO_CODE_PEPPER=
POSTGRES_PASSWORD=

# Cloudflare Turnstile -- the SECRET, not the site key.
TURNSTILE_SECRET=
