# Caddy runs BEHIND Coolify's proxy, which terminates TLS and forwards over
# the Docker network. So Caddy's direct peer is that proxy, never Cloudflare
# and never the visitor, and the request chain is:
#
#   visitor -> Cloudflare -> Coolify's proxy -> Caddy -> n8n
#
# `trusted_proxies private_ranges` tells Caddy to believe the forwarding
# header when it arrives from a private address -- which is what the Coolify
# proxy is, over the compose network. Cloudflare's own ranges are NOT listed
# here: Caddy never sees Cloudflare directly, so listing them would match
# nothing.
#
# This affects the client address in the access logs, not access control --
# nothing here gates on IP.
{
	# Caddy terminates no TLS here -- Coolify's proxy already did. Both site
	# blocks below are http:// for the same reason; without that, Caddy would
	# try to provision its own certificates for hostnames it cannot validate.
	auto_https off

	servers {
		trusted_proxies static private_ranges
	}
}

http://{$DEMO_DOMAIN} {
	encode gzip

	# The demo API. Same origin as the site, which is what lets the
	# session ride in an httpOnly SameSite=Strict cookie.
	#
	# handle_path, NOT handle. Caddy runs the directives inside a handle block
	# in its own fixed order rather than the order they are written, and
	# `rewrite` sorts before `uri`. So `uri strip_prefix` written above a
	# `rewrite` runs AFTER it: the rewrite fires on the untouched path,
	# producing /webhook/demo/api/demo/request-code, and strip_prefix then
	# finds no /api/demo at the front of that and silently does nothing.
	#
	# handle_path strips its own matched prefix as part of entering the block,
	# before anything inside runs, so the order is not in question. The result
	# here is /api/demo/request-code -> /webhook/demo/request-code.
	# {uri} rather than {path} so query strings survive.
	handle_path /api/demo/* {
		rewrite * /webhook/demo{uri}
		reverse_proxy n8n:5678
	}

	handle {
		root * /srv/site
		try_files {path} {path}/ {path}.html
		file_server
	}

	header {
		# Defaults to "all" so production stays indexable if this is never set --
		# a silently de-indexed live site is the worse failure of the two.
		# On a staging hostname set ROBOTS_TAG="noindex, nofollow": it serves the
		# same unfinished site, and a subdomain is discoverable through
		# certificate transparency logs with nothing linking to it.
		X-Robots-Tag "{$ROBOTS_TAG:all}"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
	}
}

# www -> apex. The site block above matches {$DEMO_DOMAIN} exactly, so without
# this a request for www lands on no site block and Caddy answers 404 -- which
# is what any existing link or bookmark using www would get after cutover.
#
# Harmless when unused: with no www DNS record this block simply never matches.
# 308 rather than 302, so the redirect is cached and the method is preserved.
http://www.{$DEMO_DOMAIN} {
	redir https://{$DEMO_DOMAIN}{uri} 308
}

# The n8n editor on its own hostname, never the public one.
http://{$N8N_HOST} {
	# No IP allowlist and no basic auth here, deliberately. n8n's own user
	# management is the gate: accounts, password hashing, sessions, and MFA.
	# Both earlier layers were removed because several people need access from
	# different connections, and a shared second password is a credential to
	# distribute and rotate rather than a meaningful barrier on top of n8n's.
	#
	# The consequence to know: n8n serves an UNAUTHENTICATED setup screen until
	# an owner account exists. Whoever reaches a fresh instance first claims it.
	# Never expose a newly-provisioned n8n on this hostname without completing
	# setup, and enable MFA on the owner account -- this is now the only gate
	# in front of every credential the demo stores.
	reverse_proxy n8n:5678
}
