# Caddy runs BEHIND Coolify's proxy, which terminates TLS and forwards over
# the Docker network. So Caddy's direct peer is that proxy, never Cloudflare
# and never the visitor, and the request chain is:
#
#   visitor -> Cloudflare -> Coolify's proxy -> Caddy -> n8n
#
# `trusted_proxies private_ranges` tells Caddy to believe the forwarding
# header when it arrives from a private address -- which is what the Coolify
# proxy is, over the compose network. Cloudflare's own ranges are NOT listed
# here: Caddy never sees Cloudflare directly, so listing them would match
# nothing.
#
# This affects the client address in the access logs, not access control --
# nothing here gates on IP.
{
	# Caddy terminates no TLS here -- Coolify's proxy already did. Both site
	# blocks below are http:// for the same reason; without that, Caddy would
	# try to provision its own certificates for hostnames it cannot validate.
	auto_https off

	servers {
		trusted_proxies static private_ranges
	}
}

http://{$DEMO_DOMAIN} {
	encode gzip

	# The demo API. Same origin as the site, which is what lets the
	# session ride in an httpOnly SameSite=Strict cookie.
	handle /api/demo/* {
		uri strip_prefix /api/demo
		rewrite * /webhook/demo{uri}
		reverse_proxy n8n:5678
	}

	handle {
		root * /srv/site
		try_files {path} {path}/ {path}.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
	}
}

# The n8n editor on its own hostname, never the public one.
http://{$N8N_HOST} {
	# There is deliberately NO IP allowlist here. Several people need to reach
	# this editor from different connections, and an allowlist across three
	# proxies is both fragile and a maintenance tax -- it locks out whoever's
	# address moved rather than whoever shouldn't be here.
	#
	# Two layers guard it instead: this password, and n8n's own user accounts
	# behind it. Generate the hash with `caddy hash-password` and set
	# N8N_ADMIN_USER / N8N_ADMIN_PASSWORD_HASH in Coolify's environment
	# variables -- see deploy/README.md.
	basic_auth {
		{$N8N_ADMIN_USER} {$N8N_ADMIN_PASSWORD_HASH}
	}

	reverse_proxy n8n:5678
}
